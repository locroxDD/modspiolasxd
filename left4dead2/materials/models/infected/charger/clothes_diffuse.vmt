VertexLitGeneric
{
$baseTexture "models\infected\charger/clothes_diffuse"
$bumpmap "models\infected\charger/clothes_normal"
$halflambert 1
$diffuseexp 1

//$lightwarptexture "models\survivors\coach\coach_head_wrp"

$phong 1
$phongboost 4
//$phongexponent 30
//$phongfresnelranges "[.1 .5 5]"

$ambientocclusion 1

$detail "models/infected/common/l4d2/ci_burning"
$seamless_detail 1
$seamless_scale ".005"
$detailscale 4
$detailblendfactor .001
$detailblendmode 2

$allowdiffusemodulation 0

$bbqamount 1
$BurnLevel 0.0
$multi 3.0
$blendMin 0.0
$blendMax 1.2

Proxies
{
BBQLevel
{
resultVar $bbqamount
}
BurnLevel
{
resultVar $burnlevel
}
Multiply
{
srcVar1 $BurnLevel
srcVar2 $multi
resultVar $BurnLevel
}
Clamp
{
min $blendMin
max $blendMax
srcVar1 $BurnLevel
resultVar $BurnLevel
}
Equals
{
srcVar1 $BurnLevel
resultVar $detailblendfactor
}
}

}
